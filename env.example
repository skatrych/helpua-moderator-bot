# Sample configuration for the deacon-bot (TypeScript / NestJS) service.
#
#     cp env.example .env      (dotenv reads `.env`, not this file)
#
# WHY THIS FILE IS NOT NAMED `.env.example`
# The runtime snapshot did contain a `.env.example`, and it was reviewed. It
# carried the same placeholder token/chat values as below, but its DATABASE_URL
# named a private-range internal host address and a real database role name.
# This repository is public, so those two tokens were replaced with the local
# placeholders below; nothing else was changed. The harness also blocks writing
# any `.env*` path, which is why the conventional leading dot is absent here.
# See docs/RECONSTRUCTION.md section 6.

# --- Telegram ---------------------------------------------------------------
# BotFather token. NEVER commit a real one.
BOT_TOKEN='0000000000:REPLACE-ME-REPLACE-ME-REPLACE-ME'

# HelpUkraine supergroup id (negative, with the -100 prefix).
CHAT_ID='-1001234567890'

# 1 = long polling from the container, 0 = webhook behind the nginx/reverse-proxy
# that docker-compose.yaml describes.
BOT_POLLING=1

# NOTE: read as `Boolean(Number(x)) || true`, which is *always* true — see
# docs/RECONSTRUCTION.md section 7. The original comments warn to keep this on
# until the ctx.reply() bug is fixed.
IS_BOT_SILENT=1

# --- Silent window ----------------------------------------------------------
# Documented as UTC, but evaluated with Date#getHours() in the CONTAINER's local
# timezone. docker-compose.yaml sets no TZ, so set one if this matters.
IS_TOO_EARLY=5
IS_TOO_LATE=21

# --- Postgres ---------------------------------------------------------------
# Both are required: schema.prisma declares a `shadowDatabaseUrl`, which
# `prisma migrate` needs.
DATABASE_URL="postgresql://deacon:deacon@localhost:5432/deacon_bot?schema=public"
SHADOW_DATABASE_URL="postgresql://deacon:deacon@localhost:5432/deacon_bot_shadow?schema=public"

# --- Announcements ----------------------------------------------------------
# Optional overrides; src/announcement/announcement.service.ts documents the
# defaults, which are Ukrainian.
# GROUP_CLOSURE_ANNOUNCEMENT="..."
# GROUP_OPENED_ANNOUNCEMENT="..."
